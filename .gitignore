*.py[cod]
.venv/

# Local credentials (only a placeholder environment template may be shared)
.env
.env.*
!/.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
client_secret*.json
transport_config*.json
!/examples/transport_config.example.json
.aws/
.ssh/

# Real calibration data; keep the reviewed synthetic example
roi_config*.json
!/examples/roi_config.example.json
/local/

